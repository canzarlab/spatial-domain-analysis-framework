Aim: Spatial Domains Benchmark

Run:    # dry run
        snakemake -s snakefile_name.smk --cores all -n
        # Touch output files (mark them up to date without really changing them) instead of running their commands.
        snakemake -t
        # Number of Jobs
        snakemake -p -j 20
        # DAG Jobs
        snakemake --dag | dot -Tpdf > jobs_dag.pdf
        # DAG Rules
        snakemake --rulegraph | dot -Tsvg > rules_dag.svg
        ## Go on with independent jobs if a job fails.
        snakemake -p -j 20 -k
        ## Force the re-execution or creation of the given rules or files.
        snakemake -p -j 20 -R rule_name
"""

